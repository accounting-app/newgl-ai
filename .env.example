# Bun/TS internal AI service. No public IP in production -- only newgl-api
# can reach it (Fly private network there, localhost here).

APP_ENV=local
PORT=3002

# Same Postgres as newgl-api (schema owned by newgl-api's migrations; this
# service only ever touches the ai_* tables). Local Supabase Postgres by
# default -- run `bunx supabase start` from newgl-api first.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Shared secret with newgl-api. Must match INTERNAL_SERVICE_TOKEN in
# newgl-api/.env exactly. Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=<same value as newgl-api's INTERNAL_SERVICE_TOKEN>

# Master key for encrypting BYOK Anthropic keys at rest (AES-256-GCM).
# Must decode from base64 to exactly 32 bytes. Generate with:
#   openssl rand -base64 32
AI_KEY_ENCRYPTION_KEY=<32-byte base64 key>

# Platform Anthropic key, used for every tenant on the free plan with no
# BYOK key configured.
ANTHROPIC_API_KEY=<platform Anthropic key>
ANTHROPIC_MODEL=claude-opus-4-8
